        data-asset-viewer-uri="https://iiif.elifesciences.org/lax/34408%2Felife-34408-fig2-v1.tif/full/1500,/0/default.jpg"
        data-asset-viewer-width="1500"
        data-asset-viewer-height="1261"
    >
    
      <div class="asset-viewer-inline__header_panel">
          <div class="asset-viewer-inline__header_text">
            <span class="asset-viewer-inline__header_text__prominent">Figure 2</span>
          </div>
    
    
            <div class="asset-viewer-inline__figure_access">
              <a href="https://elifesciences.org/download/aHR0cHM6Ly9paWlmLmVsaWZlc2NpZW5jZXMub3JnL2xheC8zNDQwOCUyRmVsaWZlLTM0NDA4LWZpZzItdjEudGlmL2Z1bGwvZnVsbC8wL2RlZmF1bHQuanBn/elife-34408-fig2-v1.jpg?_hash=5Vt9xpdwmfwN8viKPvbhAPLoodumA8n7ZiAf3vE5vo4%3D" class="asset-viewer-inline__download_all_link" download="Download"><span class="visuallyhidden">Download asset</span></a>
