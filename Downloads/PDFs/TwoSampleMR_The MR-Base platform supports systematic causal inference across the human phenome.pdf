                      type="image/webp"
                      >
                  <source srcset="https://iiif.elifesciences.org/lax/34408%2Felife-34408-fig5-v1.tif/full/1234,/0/default.jpg 2x, https://iiif.elifesciences.org/lax/34408%2Felife-34408-fig5-v1.tif/full/617,/0/default.jpg 1x"
                      type="image/jpeg"
