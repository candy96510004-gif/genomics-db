    </li>
    <li class="reference-list__item">
      <div class="reference" data-popup-label="See in references" data-popup-contents="bib8" id="bib8">
          <ol class="reference__authors_list">
              <li class="reference__author">
                <a href="https://scholar.google.com/scholar?q=%22author:Bowden+J%22" class="reference__authors_link">Bowden J</a></li>
              <li class="reference__author">
                <a href="https://scholar.google.com/scholar?q=%22author:Del+Greco+M+F%22" class="reference__authors_link">Del Greco M F</a></li>
              <li class="reference__author">
