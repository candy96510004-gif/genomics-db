            </div>
    
      </div>
    
          <figure class="captioned-asset">
          
              <a href="https://iiif.elifesciences.org/lax/34408%2Felife-34408-fig4-v1.tif/full/full/0/default.jpg" class="captioned-asset__link" target="_blank" rel="noopener noreferrer">
